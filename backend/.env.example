DJANGO_SECRET_KEY=<secret-largo-y-aleatorio>
DJANGO_DEBUG=false

DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<password-del-pooler>
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_ALLOW_MODEL_BACKEND=false
DJANGO_SILENCE_FIELDS_W342=false

DJANGO_ALLOWED_HOSTS=api.secundaria7.dpdns.org,.vercel.app,secundaria7.com.ar

CORS_ALLOWED_ORIGINS=https://secundaria7.com.ar,https://secundaria7.vercel.app,https://<tu-proyecto>.vercel.app,http://localhost:5173,http://127.0.0.1:5173

CSRF_TRUSTED_ORIGINS=https://api.secundaria7.dpdns.org,https://secundaria7.com.ar,https://secundaria7.vercel.app,https://<tu-proyecto>.vercel.app
